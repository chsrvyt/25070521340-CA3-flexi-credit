# Copy this file to server/.env and fill in the values.
# .env is ignored by git, so your connection string and secret stay on your computer.

# MongoDB connection string - the same one you use to connect in MongoDB Compass.
# Local MongoDB:  mongodb://localhost:27017
# MongoDB Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGO_URI=

# Database name (optional, default: todoDb).
# In Compass it will contain the users, todos, notes and messages collections.
DB_NAME=

# Any long random string, used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port for the API (optional, default: 5000)
PORT=
